{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bunniplc.com"
        }
      ],
      "destination": "https://bunniplc.com/$1",
      "permanent": true
    }
  ],
  "functions": {
    "api/chat.js": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/leads.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
